# ==============================================================================
# OpenQuant / FNO Automation: Environment Secrets & Configuration Template
# ==============================================================================
# Copy this file to .env and populate with your own credentials.
# NEVER commit the active .env file to version control.

# --- Telegram Ingestion Credentials (from https://my.telegram.org) ---
API_ID=
API_HASH=
SESSION_NAME=fno_session
TARGET_CHANNELS=

# --- Telegram Bot Transport Fallback (Optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord Notification Transport ---
DISCORD_WEBHOOK_URL=

# --- At-Rest Data Encryption (Fernet 32-byte Base64 Key) ---
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Quantitative Risk Limits ---
MAX_MARGIN_RUPEES=10000.0
