# ==============================================================================
# OpenQuant-FNO: Environment Configuration
# ==============================================================================

# Telegram API Credentials (from https://my.telegram.org)
API_ID=your_api_id_here
API_HASH=your_api_hash_here
SESSION_NAME=openquant_session

# Target Channels (comma-separated list of @usernames, channel IDs, or 'me')
# e.g., @insider_traderoom,-100123456789,me
TARGET_CHANNELS=@insider_traderoom,me

# Discord Webhook URL for instant high-contrast alert dispatch
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Execution & Risk Parameters
MAX_MARGIN_RUPEES=10000
MARKET_HOURS_ONLY=false

# OpenBB Platform API Server Configuration
OPENBB_API_HOST=127.0.0.1
OPENBB_API_PORT=6900
