# ==============================================================================
# OpenQuant-FNO: Environment Configuration
# ==============================================================================

# Yahoo Finance API Credentials
API_ID=your_api_id_here
API_HASH=your_api_hash_here
SESSION_NAME=openquant_session

# Target Channels (comma-separated list of channel identifiers or 'me')
TARGET_CHANNELS=signals_channel,me

# Discord Webhook URL for instant high-contrast alert dispatch
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Execution & Risk Parameters
MAX_MARGIN_RUPEES=10000
MARKET_HOURS_ONLY=false

# OpenBB Platform API Server Configuration
OPENBB_API_HOST=127.0.0.1
OPENBB_API_PORT=6900
